OWNER_ID=
ALLOWED_USER_IDS=
PER_USER_DAILY_CAP=40
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODELS_CONFIG_PATH=models.yaml
DB_PATH=data/bot.db
PER_MODEL_TIMEOUT_SECONDS=47
ROUND_TIMEOUT_SECONDS=50
MIN_VALID_RESPONSES=3
MAX_IMAGE_BYTES=10485760
MIN_IMAGE_DIMENSION=600
BLUR_VARIANCE_WARN=120.0
BLUR_VARIANCE_REJECT=40.0
LOG_LEVEL=INFO
DEBUG_LOG_RAW_BODIES=false

# Global daily spend cap in USD, UTC day boundary. High placeholder by design: the owner
# has not chosen a real budget yet ("no cap" decision), so this keeps the cap mechanism
# built and tested but dormant. Lower it once a real daily budget is chosen.
DAILY_SPEND_CAP_USD=1000
# Reservation safety multiplier applied to every round's cost estimate, covering one
# possible JSON-repair retry (a second billable inference call) without a second reservation.
ROUND_COST_SAFETY_MULTIPLIER=1.25

# This file is a template. Copy it to .env and fill in real values; .env is git-ignored.
